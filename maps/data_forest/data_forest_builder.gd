class_name DataForestBuilder
extends ZoneBuilderBase
## Builds the Data Forest's scenery procedurally and deterministically:
##   rolling forest floor with a lake basin, paths between the Ranger Camp,
##   Crystal Lake, Old Ruins and the Gateway home; crystal trees, glowing
##   mushrooms, mossy rocks, grass, fireflies and digital landmarks.
## Gameplay objects (NPCs, spawners, portal, pickups…) live in the .tscn,
## generated by tools/build_data_forest_scene.gd.

const SIZE := 200.0
const CELL := 2.0
const PLAY_RADIUS := 66.0

const CAMP := Vector2(-22, 22)
const CAMP_RADIUS := 9.0
const LAKE := Vector2(4, -30)
const LAKE_RADIUS := 13.0
const LAKE_DEPTH := 2.2
const WATER_Y := -0.55
const RUINS := Vector2(40, 6)
const RUINS_RADIUS := 12.0
const PORTAL := Vector2(-46, 46)
const GROVES := [[Vector2(18, 36), Vector2(13, 9)], [Vector2(-42, -12), Vector2(9, 10)]]
const HILLS := [[Vector2(-10, -54), 16.0, 5.0], [Vector2(54, -32), 13.0, 4.0], [Vector2(-58, 8), 11.0, 3.0],
	[Vector2(48, 44), 12.0, 3.0]]
const FLAT_ZONES := [[CAMP, 10.0, 0.05], [RUINS, 13.0, 0.3], [PORTAL, 7.0, 0.1]]
const FOREST_ZONES := [[Vector2(-50, -40), 20.0], [Vector2(-8, 52), 14.0], [Vector2(56, -8), 12.0],
	[Vector2(30, -52), 14.0], [Vector2(-56, 28), 12.0], [Vector2(-22, -30), 10.0]]

var _noise := FastNoiseLite.new()
var _detail := FastNoiseLite.new()


func _init() -> void:
	seed_value = 20251031
	terrain_size = SIZE
	terrain_cell = CELL
	play_radius = PLAY_RADIUS
	decorative_nodes = ["Grass", "Fireflies", "LilyPads", "SmallMushrooms"]
	_noise.seed = 21
	_noise.frequency = 0.032
	_noise.fractal_octaves = 3
	_detail.seed = 5
	_detail.frequency = 0.11
	paths = [
		PackedVector2Array([Vector2(-44, 44), Vector2(-34, 34), Vector2(-26, 26)]),
		PackedVector2Array([Vector2(-18, 16), Vector2(-10, 4), Vector2(-4, -8), Vector2(0, -15)]),
		PackedVector2Array([Vector2(-14, 22), Vector2(0, 18), Vector2(14, 14), Vector2(29, 8)]),
		PackedVector2Array([Vector2(0, 18), Vector2(10, 27)]),
		PackedVector2Array([Vector2(-27, 15), Vector2(-34, 2), Vector2(-38, -4)]),
	]


func _build_scenery() -> void:
	_build_lake()
	_build_camp()
	_build_ruins()
	_build_portal_area()
	_build_trees()
	_build_mushrooms()
	_build_rocks()
	_build_grass()
	_build_fireflies()
	_data_cubes([CAMP, LAKE, RUINS, PORTAL, Vector2(-10, -54), Vector2(50, 44)], 8,
		[Color(0.35, 1.0, 0.8), Color(0.75, 0.55, 1.0), Color(1.0, 0.6, 0.85)])
	_sky_islands(5, Color("4fb88a"), Color("6a5a8e"))


# ---------------------------------------------------------------------------
# Height field
# ---------------------------------------------------------------------------

func get_height(x: float, z: float) -> float:
	var p := Vector2(x, z)
	var h := _noise.get_noise_2d(x, z) * 0.8 + _detail.get_noise_2d(x, z) * 0.15
	var r := p.length()
	h += smoothstep(PLAY_RADIUS - 6.0, PLAY_RADIUS + 20.0, r) * (16.0 + _noise.get_noise_2d(x * 2.0, z * 2.0) * 6.0)
	for hill in HILLS:
		var d := p.distance_to(hill[0])
		if d < hill[1]:
			h += hill[2] * smoothstep(hill[1], 0.0, d)
	for zone in FLAT_ZONES:
		var d := p.distance_to(zone[0])
		if d < zone[1] + 4.0:
			h = lerpf(h, zone[2], 1.0 - smoothstep(zone[1], zone[1] + 4.0, d))
	var path_d := distance_to_paths(p)
	if path_d < 5.0:
		h = lerpf(h, minf(h, 0.05) * 0.3, 1.0 - smoothstep(2.5, 5.0, path_d))
	var lake_d := p.distance_to(LAKE)
	h = lerpf(h, -LAKE_DEPTH, 1.0 - smoothstep(LAKE_RADIUS - 3.0, LAKE_RADIUS + 1.5, lake_d))
	return h


func _ground_color(x: float, z: float, h: float) -> Color:
	var p := Vector2(x, z)
	var n := _noise.get_noise_2d(x * 1.7 + 40.0, z * 1.7)
	var c := Color("2f8a4f").lerp(Color("4ea85f"), clampf(n * 0.9 + 0.5, 0.0, 1.0))
	for grove in GROVES:
		var gd := _box_distance(p, grove[0], grove[1])
		if gd < 3.0:
			c = c.lerp(Color("25774a"), 1.0 - smoothstep(0.0, 3.0, gd))
	c = c.lerp(Color("2f6f4f"), smoothstep(2.0, 6.0, h))
	c = c.lerp(Color("7f86a8"), smoothstep(7.0, 13.0, h))
	c = c.lerp(Color("c2ad86"), 1.0 - smoothstep(1.8, 3.2, distance_to_paths(p)))
	var camp_d := p.distance_to(CAMP)
	if camp_d < CAMP_RADIUS + 2.0:
		c = c.lerp(Color("b89f78"), 1.0 - smoothstep(CAMP_RADIUS - 1.5, CAMP_RADIUS + 2.0, camp_d))
	var ruins_d := p.distance_to(RUINS)
	if ruins_d < RUINS_RADIUS + 2.0:
		c = c.lerp(Color("a9a3b8"), 1.0 - smoothstep(RUINS_RADIUS - 1.0, RUINS_RADIUS + 2.0, ruins_d))
	var lake_d := p.distance_to(LAKE)
	if lake_d < LAKE_RADIUS + 3.0:
		c = c.lerp(Color("cbbd8c"), 1.0 - smoothstep(LAKE_RADIUS + 0.5, LAKE_RADIUS + 3.0, lake_d))
	if h < -0.8:
		c = c.lerp(Color("2a6f8a"), smoothstep(-0.8, -1.6, h))
	return c


