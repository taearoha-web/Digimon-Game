[ext_resource type="Script" path="res://systems/dialogue/dialogue_line.gd" id="1_1m3te"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue_data.gd" id="2_h5agc"]

[sub_resource type="Resource" id="Resource_gw2iv"]
script = ExtResource("1_1m3te")
speaker = "{npc_name}"
text = "Bzzt! Greetings, Tamer {player_name}. I am Byte, archivist of this zone."
emotion = &""

[sub_resource type="Resource" id="Resource_xu68v"]
script = ExtResource("1_1m3te")
speaker = "{npc_name}"
text = "A data storm scattered fragments of my archive all over the place. They glow like little floating cubes."
emotion = &""

[sub_resource type="Resource" id="Resource_7up4k"]
script = ExtResource("1_1m3te")
speaker = "{npc_name}"
text = "Could you collect three Data Fragments for me? Just walk up to one and pick it up."
emotion = &""

[resource]
script = ExtResource("2_h5agc")
id = &"byte_offer"
lines = Array[ExtResource("1_1m3te")]([SubResource("Resource_gw2iv"), SubResource("Resource_xu68v"), SubResource("Resource_7up4k")])
skippable = true
