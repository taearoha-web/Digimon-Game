[gd_resource type="Resource" script_class="DialogueData" load_steps=8 format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue_line.gd" id="1_v3nr7"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue_data.gd" id="2_683q4"]

[sub_resource type="Resource" id="Resource_ch584"]
script = ExtResource("1_v3nr7")
speaker = ""
text = "A soft chime wakes you. Lines of light stream past like shooting stars…"
emotion = &""

[sub_resource type="Resource" id="Resource_luu42"]
script = ExtResource("1_v3nr7")
speaker = ""
text = "When the glow fades, you are standing somewhere impossible: a world built from living data."
emotion = &""

[sub_resource type="Resource" id="Resource_424s4"]
script = ExtResource("1_v3nr7")
speaker = "{partner_name}"
text = "…Hey! Hey, are you okay? You're {player_name}, right? I've been waiting for you!"
emotion = &"happy"

[sub_resource type="Resource" id="Resource_sd5vu"]
script = ExtResource("1_v3nr7")
speaker = "{partner_name}"
text = "This is the Digital World. It's where Digimon like me live. And now… you're my Tamer!"
emotion = &"happy"

[sub_resource type="Resource" id="Resource_h7211"]
script = ExtResource("1_v3nr7")
speaker = ""
text = "Your adventure begins."
emotion = &""

[resource]
script = ExtResource("2_683q4")
id = &"intro_sequence"
lines = Array[ExtResource("1_v3nr7")]([SubResource("Resource_ch584"), SubResource("Resource_luu42"), SubResource("Resource_424s4"), SubResource("Resource_sd5vu"), SubResource("Resource_h7211")])
skippable = true
