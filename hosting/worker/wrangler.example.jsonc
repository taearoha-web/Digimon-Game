{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toon-tale",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../docs/play",
    "binding": "ASSETS",
    "run_worker_first": ["/api/account/*", "/api/online/*", "/api/league/*", "/sw.js", "/", "/index.html", "/manifest.webmanifest"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "toon-tale-accounts",
    "database_id": "REPLACE_WITH_AUTHORIZED_TARGET_DATABASE_ID",
    "migrations_dir": "../accounts/drizzle"
  }],
  "durable_objects": {
    "bindings": [{"name": "WORLD", "class_name": "WorldRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["WorldRoom"]}]
}
