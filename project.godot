[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="digimon"
3d_physics/layer_4="interactable"
3d_physics/layer_5="npc"
3d_physics/layer_6="trigger"

[navigation]

3d/default_cell_size=0.3
3d/merge_rasterizer_cell_scale=0.001

[physics]

3d/default_gravity=18.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.0470588, 0.0705882, 0.188235, 1)
anti_aliasing/quality/msaa_3d=1
